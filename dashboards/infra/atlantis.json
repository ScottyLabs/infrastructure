{
  "title": "Atlantis",
  "uid": "infra-atlantis",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Atlantis up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"atlantis\"}" }],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Plan success rate (24h)",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "100 * sum(increase({__name__=~\"atlantis_cmd_(autoplan|comment_plan)_execution_success\"}[24h])) / clamp_min(sum(increase({__name__=~\"atlantis_cmd_(autoplan|comment_plan)_execution_(success|error|failure)\"}[24h])), 1)"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Apply success rate (24h)",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "100 * sum(increase(atlantis_cmd_comment_apply_execution_success[24h])) / clamp_min(sum(increase({__name__=~\"atlantis_cmd_comment_apply_execution_(success|error|failure)\"}[24h])), 1)"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Apply errors (24h)",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase({__name__=~\"atlantis_cmd_comment_apply_execution_(error|failure)\"}[24h])) or vector(0)"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Goroutines",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "atlantis_scheduled_runtime_cpu_goroutines{job=\"atlantis\"}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Operations per minute (success)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (__name__) (rate({__name__=~\"atlantis_cmd_.*_execution_success\"}[5m])) * 60",
        "legendFormat": "{{__name__}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ops/min", "min": 0, "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Operations per minute (errors + failures)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (__name__) (rate({__name__=~\"atlantis_cmd_.*_execution_(error|failure)\"}[5m])) * 60",
        "legendFormat": "{{__name__}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ops/min", "min": 0 } }
    },
    {
      "id": 20, "type": "timeseries", "title": "Project execution latency (Tally summary, plan+apply unified)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "avg(atlantis_project_execution_time{quantile=\"0.5\"})", "legendFormat": "p50" },
        { "expr": "avg(atlantis_project_execution_time{quantile=\"0.95\"})", "legendFormat": "p95" },
        { "expr": "avg(atlantis_project_execution_time{quantile=\"0.99\"})", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Builder & pull-closed-cleanup throughput",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(atlantis_builder_execution_success[5m]) * 60", "legendFormat": "builder success/min" },
        { "expr": "rate(atlantis_builder_execution_error[5m]) * 60", "legendFormat": "builder errors/min" },
        { "expr": "rate(atlantis_pullclosed_cleanup_execution_success[5m]) * 60", "legendFormat": "pullclosed success/min" },
        { "expr": "rate(atlantis_pullclosed_cleanup_execution_error[5m]) * 60", "legendFormat": "pullclosed errors/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops/min", "min": 0 } }
    },
    {
      "id": 30, "type": "table", "title": "Project executions — success (24h)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (project, base_repo, workspace) (increase(atlantis_project_execution_success[24h]))", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ]
    },
    {
      "id": 31, "type": "table", "title": "Project executions — errors + failures (24h)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (project, base_repo, workspace) (increase({__name__=~\"atlantis_project_execution_(error|failure)\"}[24h]))", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ]
    },
    {
      "id": 40, "type": "timeseries", "title": "Goroutines & GC pauses",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "atlantis_scheduled_runtime_cpu_goroutines{job=\"atlantis\"}", "legendFormat": "goroutines" },
        { "expr": "rate(atlantis_scheduled_runtime_memory_gc_pause_total{job=\"atlantis\"}[5m])", "legendFormat": "gc pause ns/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 41, "type": "timeseries", "title": "Process memory (Go runtime)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "atlantis_scheduled_runtime_memory_alloc{job=\"atlantis\"}", "legendFormat": "heap alloc" },
        { "expr": "atlantis_scheduled_runtime_memory_heap_inuse{job=\"atlantis\"}", "legendFormat": "heap in-use" },
        { "expr": "atlantis_scheduled_runtime_memory_sys{job=\"atlantis\"}", "legendFormat": "sys (reserved)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } }
    }
  ]
}
