{
  "title": "Synapse",
  "uid": "infra-synapse",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"synapse\"}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Daily active users",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(synapse_admin_daily_active_users)" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3, "type": "stat", "title": "Notifier rooms",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(synapse_notifier_rooms)" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4, "type": "stat", "title": "In-flight requests",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(synapse_http_server_in_flight_requests_count)" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5, "type": "stat", "title": "Events persisted",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(synapse_storage_events_persisted_events_total)" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Request rate by servlet",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (servlet) (rate(synapse_http_server_response_count_total[5m]))",
        "legendFormat": "{{servlet}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Response latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(synapse_http_server_response_time_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(synapse_http_server_response_time_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(synapse_http_server_response_time_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 20, "type": "timeseries", "title": "Federation outbound (transactions & EDUs)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(synapse_federation_client_sent_transactions_total[5m]))", "legendFormat": "transactions/s" },
        { "expr": "sum(rate(synapse_federation_client_sent_edus_total[5m]))", "legendFormat": "edus/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Federation inbound staging",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(synapse_federation_server_number_inbound_pdu_in_staging)", "legendFormat": "PDUs in staging" },
        { "expr": "sum(synapse_federation_server_oldest_inbound_pdu_in_staging)", "legendFormat": "oldest staging ms" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Events persisted",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(synapse_storage_events_persisted_events_total[5m]))",
        "legendFormat": "events/s"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "id": 30, "type": "timeseries", "title": "Event processing lag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "max by (name) (synapse_event_processing_lag)",
        "legendFormat": "{{name}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 } }
    },
    {
      "id": 31, "type": "timeseries", "title": "DB query time p95 by verb",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, verb) (rate(synapse_storage_query_time_bucket[5m])))",
        "legendFormat": "{{verb}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 40, "type": "timeseries", "title": "Background processes in flight",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (name) (synapse_background_process_in_flight_count)",
        "legendFormat": "{{name}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 41, "type": "timeseries", "title": "Process CPU (user + system)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(process_cpu_user_seconds_total{job=\"synapse\"}[5m])", "legendFormat": "user" },
        { "expr": "rate(process_cpu_system_seconds_total{job=\"synapse\"}[5m])", "legendFormat": "system" },
        { "expr": "rate(process_cpu_user_seconds_total{job=\"synapse\"}[5m]) + rate(process_cpu_system_seconds_total{job=\"synapse\"}[5m])", "legendFormat": "total" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } }
    }
  ]
}
