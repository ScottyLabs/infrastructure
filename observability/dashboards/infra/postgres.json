{
  "title": "Postgres",
  "uid": "infra-postgres",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_up", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "Active connections by database",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (instance, datname) (pg_stat_database_numbackends)", "legendFormat": "{{instance}} / {{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Transactions/sec (commit + rollback)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit {{datname}}" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback {{datname}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Cache hit ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (datname) (rate(pg_stat_database_blks_hit[5m])) / (sum by (datname) (rate(pg_stat_database_blks_hit[5m])) + sum by (datname) (rate(pg_stat_database_blks_read[5m])))", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Database sizes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_database_size_bytes", "legendFormat": "{{instance}} / {{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Deadlocks + conflicts",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_deadlocks[5m]))", "legendFormat": "deadlocks {{datname}}" },
        { "expr": "sum by (datname) (rate(pg_stat_database_conflicts[5m]))", "legendFormat": "conflicts {{datname}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}
