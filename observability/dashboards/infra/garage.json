{
  "title": "Garage / S3",
  "uid": "infra-garage",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Cluster healthy",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "cluster_healthy" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DEGRADED", "color": "red" }, "1": { "text": "healthy", "color": "green" } } }] } }
    },
    {
      "id": 2, "type": "stat", "title": "Connected nodes",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "cluster_connected_nodes" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "API request rate by operation",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (api_endpoint) (rate(api_s3_request_counter[5m]))", "legendFormat": "{{api_endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "API error rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (api_endpoint) (rate(api_s3_error_counter[5m]))", "legendFormat": "{{api_endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "API latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, api_endpoint) (rate(api_s3_request_duration_bucket[5m])))", "legendFormat": "{{api_endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Local disk used vs available",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "garage_local_disk_total - garage_local_disk_avail", "legendFormat": "used" },
        { "expr": "garage_local_disk_avail", "legendFormat": "available" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Block I/O bytes/sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(block_bytes_read[5m])", "legendFormat": "read" },
        { "expr": "rate(block_bytes_written[5m])", "legendFormat": "write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Block resync queue length",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "block_resync_queue_length", "legendFormat": "queued" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
