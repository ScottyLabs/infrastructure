{
  "title": "Headscale",
  "uid": "infra-headscale",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Nodes in store",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "headscale_nodestore_nodes_total" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2, "type": "timeseries", "title": "MapResponses sent/sec",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (type) (rate(headscale_mapresponse_sent_total[5m]))", "legendFormat": "{{type}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Endpoint updates from clients/sec",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(headscale_mapresponse_endpoint_updates_total[5m])", "legendFormat": "updates" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "HTTP latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, path) (rate(headscale_http_duration_seconds_bucket[5m])))", "legendFormat": "{{path}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "NodeStore operation duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(headscale_nodestore_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
