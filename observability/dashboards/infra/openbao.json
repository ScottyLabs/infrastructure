{
  "title": "OpenBao",
  "uid": "infra-openbao",
  "schemaVersion": 39,
  "tags": ["infra"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Sealed",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vault_core_unsealed" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "SEALED", "color": "red" }, "1": { "text": "unsealed", "color": "green" } } }] } }
    },
    {
      "id": 2, "type": "stat", "title": "Cache hit ratio",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vault_cache_hit / (vault_cache_hit + vault_cache_miss)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Audit log request rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(vault_audit_log_request_count[5m])", "legendFormat": "requests" },
        { "expr": "rate(vault_audit_log_response_count[5m])", "legendFormat": "responses" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4, "type": "stat", "title": "Audit log failures",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vault_audit_log_request_failure + vault_audit_log_response_failure" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Barrier operation rates",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(vault_barrier_get_count[5m])", "legendFormat": "get" },
        { "expr": "rate(vault_barrier_put_count[5m])", "legendFormat": "put" },
        { "expr": "rate(vault_barrier_list_count[5m])", "legendFormat": "list" },
        { "expr": "rate(vault_barrier_delete_count[5m])", "legendFormat": "delete" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Barrier latency (p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "vault_barrier_get{quantile=\"0.99\"}", "legendFormat": "get" },
        { "expr": "vault_barrier_put{quantile=\"0.99\"}", "legendFormat": "put" },
        { "expr": "vault_barrier_list{quantile=\"0.99\"}", "legendFormat": "list" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Runtime memory + goroutines",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "vault_runtime_alloc_bytes", "legendFormat": "alloc bytes" },
        { "expr": "vault_runtime_sys_bytes", "legendFormat": "sys bytes" },
        { "expr": "vault_runtime_num_goroutines * 1048576", "legendFormat": "goroutines (×1MiB scale)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "GC pauses",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(vault_runtime_gc_pause_ns_sum[5m]) / 1e9", "legendFormat": "GC pause s/s" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
